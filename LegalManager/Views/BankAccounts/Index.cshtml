@model IEnumerable<LegalManager.Models.Entities.Finance.BankAccount>

@{
    ViewData["Title"] = "Index";
}
<div class="col-md-12">
    <div class="card">
        <div class="header">
            <h3 class="title">Bank Accounts</h3>
            <a class="btn btn-info btn-fill pull-right" asp-action="Create">Create New Account</a>
        </div>
        <hr />

        <div class="row">
            <div class="col-md-12">
<table class="table table-striped">
    <thead>
        <tr>

            <th>
                Name
            </th>
            <th>
                Pay Name
            </th>
            <th>
                Sort Code
            </th>
            <th>
                Account Number
            </th>
            <th>
                IBAN
            </th>
            <th>
                BIC
            </th>
            <th>
               Account Type
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AccountName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccountPayName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccountSortCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccountNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccountIBAN)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccountBIC)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccountType)
            </td>
            <td>
                <a class="btn btn-primary btn-fill" asp-action="Details" asp-route-id="@item.BankId">Open</a>
                <a class="btn btn-info btn-fill" asp-action="Edit" asp-route-id="@item.BankId">Edit</a>
                <a class="btn btn-danger btn-fill" asp-action="Delete" asp-route-id="@item.BankId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
</div>
</div>
</div>

