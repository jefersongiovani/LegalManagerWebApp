@model LegalManager.Models.Entities.Finance.BankAccount

@{
    ViewData["Title"] = "Edit";
}



<div class="col-md-12">
    <div class="card">
        <div class="header">
            <h3 class="title">Edit Bank Account</h3>
            <a class="btn btn-info pull-right" asp-action="Index">Back to List</a>
        </div>
        <hr />
         <form asp-action="Edit">
        <div class="row">
           
            <div class="col-md-12">
    <div class="col-md-4">
        
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BankId" />
                <input type="hidden" asp-for="CompanyID" class="form-control" />

            <div class="form-group">
                <label asp-for="AccountName" class="control-label"></label>
                <input asp-for="AccountName" class="form-control" />
                <span asp-validation-for="AccountName" class="text-danger"></span>
            </div>
            </div>
               <div class="col-md-4">
            <div class="form-group">
                <label class="control-label">Pay Name</label>
                <input asp-for="AccountPayName" class="form-control" />
                <span asp-validation-for="AccountPayName" class="text-danger"></span>
            </div>
            </div>
            <div class="col-md-4">
            <div class="form-group">
                <label class="control-label">Sort Code</label>
                <input asp-for="AccountSortCode" class="form-control" />
                <span asp-validation-for="AccountSortCode" class="text-danger"></span>
            </div>
            </div>
            </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="col-md-4">
            <div class="form-group">
                <label  class="control-label">Account Number</label>
                <input asp-for="AccountNumber" class="form-control" />
                <span asp-validation-for="AccountNumber" class="text-danger"></span>
            </div>
            </div>
            <div class="col-md-4">
            <div class="form-group">
                <label  class="control-label">IBAN</label>
                <input asp-for="AccountIBAN" class="form-control" />
                <span asp-validation-for="AccountIBAN" class="text-danger"></span>
            </div>
            </div>
            <div class="col-md-4">
            <div class="form-group">
                <label  class="control-label">BIC</label>
                <input asp-for="AccountBIC" class="form-control" />
                <span asp-validation-for="AccountBIC" class="text-danger"></span>
            </div>
            </div>
            </div>
            </div>
            <div class="row">
                <div class="col-md-4">
            <div class="form-group">
                <label  class="control-label">Account Type</label>
                <input asp-for="AccountType" class="form-control" />
                <span asp-validation-for="AccountType" class="text-danger"></span>
            </div>
            </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
            
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
