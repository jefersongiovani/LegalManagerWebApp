@model LegalManager.Models.Entities.Finance.BankAccount

@{
    ViewData["Title"] = "Details";
}


<div class="col-md-12">
    <div class="card">
        <div class="header">
            <h4 class="title">Account Details</h4>
            <a class="btn btn-primary btn-fill pull-right" asp-action="Edit" asp-route-id="@Model.BankId">Edit</a> 
            <a class="btn btn-info btn-fill pull-right" asp-action="Index">Back to List</a>
        </div>
        <hr />
        <div class="row">
<div class="col-md-12">
    <dl class="row">
        <dt class = "col-md-2">
            Account Name: 
        </dt>
        <dd class = "col-md-10">
            @Html.DisplayFor(model => model.AccountName)
        </dd>
        <dt class = "col-md-2">
            Account Pay Name
        </dt>
        <dd class = "col-md-10">
            @Html.DisplayFor(model => model.AccountPayName)
        </dd>
        <dt class = "col-md-2">
            @Html.DisplayNameFor(model => model.AccountSortCode)
        </dt>
        <dd class = "col-md-10">
            @Html.DisplayFor(model => model.AccountSortCode)
        </dd>
        <dt class = "col-md-2">
            @Html.DisplayNameFor(model => model.AccountNumber)
        </dt>
        <dd class = "col-md-10">
            @Html.DisplayFor(model => model.AccountNumber)
        </dd>
        <dt class = "col-md-2">
            @Html.DisplayNameFor(model => model.AccountIBAN)
        </dt>
        <dd class = "col-md-10">
            @Html.DisplayFor(model => model.AccountIBAN)
        </dd>
        <dt class = "col-md-2">
            @Html.DisplayNameFor(model => model.AccountBIC)
        </dt>
        <dd class = "col-md-10">
            @Html.DisplayFor(model => model.AccountBIC)
        </dd>
        <dt class = "col-md-2">
            @Html.DisplayNameFor(model => model.AccountType)
        </dt>
        <dd class = "col-md-10">
            @Html.DisplayFor(model => model.AccountType)
        </dd>
    </dl>
</div>
    
</div>
</div>
</div>
