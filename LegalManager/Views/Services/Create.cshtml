@model LegalManager.Models.Entities.Services.ChosenService

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="header">
                        <h3 class="title">Create a new Service</h3>
                        <a class="btn btn-info btn-fill pull-right" asp-action="Index">Back to the List</a>
                    </div>
                    <hr />
                    <div class="content">
        <form asp-action="Create">
            <div class="row">
                <div class="col-md-8">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cost" class="control-label"></label>
                <input asp-for="Cost" class="form-control" />
                <span asp-validation-for="Cost" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ServiceType" class="control-label">Service Types</label>
                <select asp-for="ServiceType" class="form-control" asp-items="ViewBag.ServiceTypes">
                                            <option>Select a Service Type</option>
                                        </select>
                <span asp-validation-for="ServiceType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary btn-fill" />
            </div>
            </div>
            </div>
        </form>
    </div>
</div>
</div>
</div>
</div>
</div>




