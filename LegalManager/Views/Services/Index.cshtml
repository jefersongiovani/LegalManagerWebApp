@model IEnumerable<LegalManager.Models.Entities.Services.ChosenService>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="col-md-12">
    <div class="card">
        <div class="header">
            <h3 class="title">List of Services</h3>
            <a class="btn btn-info btn-fill pull-right" asp-action="Create">Create New Service</a>
        </div>
        <hr />
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ServiceType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                £ @Html.DisplayFor(modelItem => item.Cost)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ServiceType)
            </td>
            <td>
                <a class="btn btn-primary btn-fill" asp-action="Details" asp-route-id="@item.ServiceID">Open</a>
                <a class="btn btn-info btn-fill" asp-action="Edit" asp-route-id="@item.ServiceID">Edit</a>
                <a class="btn btn-danger btn-fill" asp-action="Delete" asp-route-id="@item.ServiceID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
</div>

