@model LegalManager.Models.Entities.Services.ChosenService

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="col-md-12">
    <div class="card">
        <div class="header">
            <h3 class="title">Service Details</h3>

            <a class="btn btn-info btn-fill pull-right" asp-action="Index">Back to List</a>
            <a class="btn btn-primary btn-fill pull-right asp-action="Edit" asp-route-id="@Model.ServiceID">Edit</a>
        </div>
        <hr />
        
        <div class="row">
            <div class="col-md-12">
                <dl>
                    <dt class="col-md-4">
                        @Html.DisplayNameFor(model => model.Title)
                    </dt>
                    <dd class="col-md-8">
                        @Html.DisplayFor(model => model.Title)
                    </dd>
                    <dt class="col-md-4">
                        @Html.DisplayNameFor(model => model.Description)
                    </dt>
                    <dd class="col-md-8">
                        @Html.DisplayFor(model => model.Description)
                    </dd>
                    <dt class="col-md-4">
                        @Html.DisplayNameFor(model => model.Cost)
                    </dt>
                    <dd class="col-md-8">
                        @Html.DisplayFor(model => model.Cost)
                    </dd>
                    <dt class="col-md-4">
                        @Html.DisplayNameFor(model => model.ServiceType)
                    </dt>
                    <dd class="col-md-8">
                        @Html.DisplayFor(model => model.ServiceType)
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

