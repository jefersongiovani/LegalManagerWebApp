@using LegalManager.Models.Entities.Cases
@model LegalManager.Models.Entities.Clients.Client

@{
    ViewData["Title"] = "Details";
}

<div class="col-md-12">
    <div class="card">
        <div class="header">
            <h3 class="title">Details of @Html.DisplayFor(model => model.FullName)</h3>

            <a class="btn btn-info btn-fill pull-right" asp-action="Index">Back to List</a>
            <a class="btn btn-primary btn-fill pull-right asp-action="Edit" asp-route-id="@Model.ClientID">Edit</a>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <table class="table table-striped table-hover table-responsive table-bordered ">
                    <tr>
                        <th>Name</th>
                        <td>@Html.DisplayFor(model => model.FullName)</td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td> @Html.DisplayFor(model => model.EmailAddress)</td>
                    </tr>
                    <tr>
                        <th>Mobile Number</th>
                        <td> @Html.DisplayFor(model => model.MobileNumber)</td>
                    </tr>
                    <tr>
                        <th>Date of Birth</th>
                        <td>@Html.DisplayFor(model => model.DateOfBirth)</td>
                    </tr>
                    <tr>
                        <th>Registered Date</th>
                        <td> @Html.DisplayFor(model => model.RegisteredDate)</td>
                    </tr>
                    <tr>
                        <th>Document Type</th>
                        <td>@Html.DisplayFor(model => model.IdentificationName)</td>
                    </tr>
                    <tr>
                        <th>Document's Registration Number</th>
                        <td> @Html.DisplayFor(model => model.Identification)</td>
                    </tr>
                    <tr>
                        <th>Naionality</th>
                        <td>@Html.DisplayFor(model => model.Nationality)</td>
                    </tr>

                </table>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="header">
            <h3 class="title">List of Cases for @Html.DisplayFor(model => model.FullName)</h3>
        </div>
        </hr>
        <div class="row">
            <div class="col-md-12">

                <table class="table table-striped table-hover table-responsive table-bordered ">
                    <tr>
                        <th scope="col">Case Type</th>
                        <th scope="col">Case Title</th>
                        <th scope="col">Date Created</th>
                        <th scope="col">Status</th>
                        <th scope="col">Action</th>
                    </tr>
                    @foreach (Case item in ViewBag.Cases)
                    {
                        <tr>
                            <td scope="row">@item.CaseType</td>
                            <td>@item.CaseTitle</td>
                            <td>@item.dateCreated</td>
                            <td>@item.Status</td>
                            <td><a class="btn btn-primary btn-fill" asp-controller="Cases" asp-action="Details" asp-route-id="@item.CaseID">Open</a></td>
                        </tr>
                    }
                </table>

            </div>
        </div>
    </div>
