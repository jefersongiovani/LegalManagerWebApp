@model LegalManager.Models.Entities.Documents.DocumentBase

<h4>DocumentBase</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="View">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CaseFK" class="control-label"></label>
                <select asp-for="CaseFK" class ="form-control" asp-items="ViewBag.CaseFK"></select>
            </div>
            <div class="form-group">
                <label asp-for="DocName" class="control-label"></label>
                <input asp-for="DocName" class="form-control" />
                <span asp-validation-for="DocName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DocDescription" class="control-label"></label>
                <input asp-for="DocDescription" class="form-control" />
                <span asp-validation-for="DocDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DocumentContent" class="control-label"></label>
                <input asp-for="DocumentContent" class="form-control" />
                <span asp-validation-for="DocumentContent" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DocFileName" class="control-label"></label>
                <input asp-for="DocFileName" class="form-control" />
                <span asp-validation-for="DocFileName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DocPath" class="control-label"></label>
                <input asp-for="DocPath" class="form-control" />
                <span asp-validation-for="DocPath" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateCreated" class="control-label"></label>
                <input asp-for="DateCreated" class="form-control" />
                <span asp-validation-for="DateCreated" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OpenTime" class="control-label"></label>
                <input asp-for="OpenTime" class="form-control" />
                <span asp-validation-for="OpenTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CloseTime" class="control-label"></label>
                <input asp-for="CloseTime" class="form-control" />
                <span asp-validation-for="CloseTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalTime" class="control-label"></label>
                <input asp-for="TotalTime" class="form-control" />
                <span asp-validation-for="TotalTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalUnits" class="control-label"></label>
                <input asp-for="TotalUnits" class="form-control" />
                <span asp-validation-for="TotalUnits" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DocLocation" class="control-label"></label>
                <input asp-for="DocLocation" class="form-control" />
                <span asp-validation-for="DocLocation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DocType" class="control-label"></label>
                <input asp-for="DocType" class="form-control" />
                <span asp-validation-for="DocType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FileContent" class="control-label"></label>
                <input asp-for="FileContent" class="form-control" />
                <span asp-validation-for="FileContent" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="isDraft" /> @Html.DisplayNameFor(model => model.isDraft)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="DateUpdated" class="control-label"></label>
                <input asp-for="DateUpdated" class="form-control" />
                <span asp-validation-for="DateUpdated" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="isDeleted" /> @Html.DisplayNameFor(model => model.isDeleted)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

