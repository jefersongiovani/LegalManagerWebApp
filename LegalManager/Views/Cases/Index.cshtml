@model IEnumerable<LegalManager.Models.Entities.Cases.Case>

@{
    ViewData["Title"] = "List of Opened Cases";
}

<div class="col-md-12">
    <div class="card">
        <div class="header">
            <h4 class="title">List of Cases</h4>
            <a class="btn btn-info btn-fill pull-right" asp-action="Create">Create New Case</a>
        </div>
        <hr />
        <table class="table table-hover table-striped">
            <thead>
                <tr>
                    <th>
                        Case Title
                    </th>
                    <th>
                        Short Description
                    </th>
                    <th>
                        Date Created
                    </th>

                    <th>
                        Client's Name
                    </th>

                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.CaseTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ShortDescription)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.dateCreated)
                        </td>
                        <td>
                            @{
                                var fullName = item.Client.FirstName + " " + item.Client.LastName;
                                @Html.DisplayFor(modelItem => fullName)
                            }
                        </td>

                        <td>
                            <a class="btn btn-primary btn-fill" asp-action="Details" asp-route-id="@item.CaseID">Open</a>
                            <a class="btn btn-info btn-fill" asp-action="Edit" asp-route-id="@item.CaseID">Edit</a>
                            <a class="btn btn-danger btn-fill" asp-action="Delete" asp-route-id="@item.CaseID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

