@using LegalManager.Models.Entities.Documents
@model LegalManager.Models.Entities.Cases.Case

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}


<div class="col-md-12">
    <div class="card">
        <div class="header">
            <h3 class="title">@Html.DisplayFor(model => model.Client.FirstName) - @Html.DisplayFor(model => model.CaseTitle) | Case Details</h3>

            <a class="btn btn-info btn-fill pull-right" asp-action="Index">Back to List</a>
            <a class="btn btn-primary btn-fill pull-right" asp-action="Edit" asp-route-id="@Model.CaseID">Edit</a>
        </div>
        <hr />

        <div class="row">
            <div class="col-md-12">

                <table class="table table-striped table-hover table-responsive table-bordered">
                    <tr>
                        <th>Client</th>
                        <td><b>@Html.DisplayFor(model => model.Client.FullName)</b></td>
                    </tr>
                    <tr>
                        <th>Case Type</th>
                        <td>@Html.DisplayFor(model => model.CaseType)</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>@Html.DisplayFor(model => model.Status) | Date Created: @Html.DisplayFor(model => model.dateCreated)</td>
                    </tr>
                    <tr>
                        <th>Case Title</th>
                        <td>@Html.DisplayFor(model => model.CaseTitle)</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td> @Html.DisplayFor(model => model.ShortDescription)</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="header">
            <h3 class="title">List of Documents</h3>
            <a class="btn btn-success btn-fill pull-right" data-toggle="modal" data-target="#exampleModal">Upload new Document</a>
            <a class="btn btn-info btn-fill pull-right" asp-action="CreateDocument" asp-route-id="@Model.CaseID">Create new Document</a>
        </div>
        <hr />

        <div class="row">
            <div class="col-md-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <table class="table table-striped table-hover table-responsive">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Document Name</th>
                        <th scope="col">Date Created</th>
                        <th scope="col">Location</th>
                        <th scope="col">is Draft?</th>
                        <th scope="col">File Name</th>
                        <th scope="col">Action</th>
                    </tr>
                    @foreach (DocumentBase item in ViewBag.Documents)
                    {
                        <tr>
                            <td scope="row">@item.DocumentID</td>
                            <td>@item.DocName</td>
                            <td>@item.DateCreated</td>
                            <td>@item.DocLocation</td>
                            <td> <input asp-for="@item.isDraft" class="form-check-input" disabled /></td>
                            <td> @item.DocFileName</td>
                            <td><a target="_blank" class="btn btn-primary btn-fill" asp-controller="Cases" asp-action="OpenDocument" asp-route-id="@item.DocumentID">View</a></td>
                        </tr>
                    }

                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" data-backdrop="false" style="background-color: rgba(0, 0, 0, 0.5);" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Document Upload</h5>
        <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close">X</button>
      </div>
            <div class="modal-body">
                <div></div>
                  <!-- Form -->
        <form method="post" id="uploadform" asp-action="UploadDocument" asp-controller="Cases" enctype="multipart/form-data">
            <input asp-for="@Model.CaseID" name="CaseID" type="hidden" id="case" />
            <input asp-for="@Model.Client.FirstName" name="firstName" type="hidden" id="firstName" />
            <input asp-for="@Model.clientID" name="clientId" type="hidden" id="clientid" />
            <input asp-for="@Model.CaseType" name="caseType" type="hidden" id="caseType" />
          Select the files : <input type='file' name='files' id='file' class='form-control' multiple /><br>
          <input type='submit' class='btn btn-success btn-fill' value='Upload' id='btn_upload'>
        </form>

            </div>

            <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal View with scrolling-->
<div class="modal fade" id="viewDocument" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="viewDocumentLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="viewDocumentLabel">Modal title</h5>
        <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close">X</button>
      </div>
      <div class="modal-body">
        ...
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>