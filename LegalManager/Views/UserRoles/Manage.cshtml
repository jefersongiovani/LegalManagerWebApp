@model List<ManageUserRolesViewModel>
@{
    ViewData["Title"] = "Manage Roles for User";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}
<div class="col-md-12">
    <div class="card">
        <div class="card-header">
            <h3>Manage Collegue Roles</h3>
            Add/Remove Roles for collegue / @ViewBag.Name

        </div>

        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <div>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <div class="form-check m-1">
                                <input type="hidden" asp-for="@Model[i].RoleId" />
                                <input type="hidden" asp-for="@Model[i].RoleName" />
                                <input asp-for="@Model[i].Selected" class="form-check-input" />
                                <label class="form-check-label" asp-for="@Model[i].Selected">
                                    @Model[i].RoleName
                                </label>
                            </div>
                        }
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <input type="submit" value="Update" class="btn btn-primary" />
                        <a asp-action="Index" asp-route-id="@ViewBag.userId"
                           class="btn btn-primary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



