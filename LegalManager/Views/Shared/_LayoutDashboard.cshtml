@using Microsoft.AspNetCore.Identity
@using LegalManager.Models.Entities.Users
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <link rel="icon" type="images/png" href="~/images/favicon.ico" />
    <link rel="manifest" href="~/manifest.json">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self';
                script-src 'self' 'unsafe-inline'  https://ajax.aspnetcdn.com/ajax/jquery.validate/1.17.0/jquery.validate.min.js https://cdn.tiny.cloud  https://kit.fontawesome.com/0cd610a63e.js https://unpkg.com/gijgo@1.9.13/js/gijgo.min.js https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js;
                style-src 'self' 'unsafe-inline' https://unpkg.com/gijgo@1.9.13/css/gijgo.min.css https://fonts.googleapis.com/css https://cdn.tiny.cloud https://sp.tinymce.com;
                object-src 'none';
                base-uri 'self';
                connect-src 'self' https://ka-f.fontawesome.com;
                font-src 'self' https://fonts.gstatic.com https://ka-f.fontawesome.com https://unpkg.com https://cdn.tiny.cloud;
                frame-src 'self';
                child-src 'self';
                img-src 'self' data: https://sp.tinymce.com https://cdn.tiny.cloud;
                form-action 'self';
                manifest-src 'self';
                media-src 'self';
                worker-src 'self';" />
    <title>@ViewData["Title"] - LegalManager</title>
    <link href="~/assets/fonts/Pe-icon-7-stroke.woff" rel="prefetch" type="font/woff2" crossorigin />

    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=1, name=viewport" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0745BA" />

    <!-- Bootstrap core CSS-->
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />

    <!--Animation library for notifications-->
    <link href="~/assets/css/animate.min.css" rel="stylesheet" type="text/css" />

    <!--  Light Bootstrap Table core CSS    -->
    <link href="~/assets/css/light-bootstrap-dashboard.css" rel="stylesheet" type="text/css" />

    <!--Calendar CSS-->
    <link type="text/css" rel="stylesheet" href="~/themes/calendar_g.css" />
    <link type="text/css" rel="stylesheet" href="~/themes/calendar_green.css" />
    <link type="text/css" rel="stylesheet" href="~/themes/calendar_traditional.css" />
    <link type="text/css" rel="stylesheet" href="~/themes/calendar_transparent.css" />
    <link type="text/css" rel="stylesheet" href="~/themes/calendar_white.css" />

    <!--Dynamic grids-->
   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!--     Fonts and icons     -->
    <script src="https://kit.fontawesome.com/0cd610a63e.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css?family=Arvo:400,700,300&display=swap" rel="stylesheet" type="text/css" crossorigin />
    <link href="~/assets/css/pe-icon-7-stroke.css" rel="stylesheet" type="text/css" />
</head>
<body>

    <!--Starting of the wrapper-->
    <div class="wrapper">
        <!--General wrapper-->
        @if (SignInManager.IsSignedIn(User))
        {
            <partial name="_SidebarPartial" /> <!--Calling the sidebar-->

            <div class="main-panel">

                <!--Starting of top menu-->

            <partial name="_TopMenu" />

                <!--End of top menu-->

            <div class="content">
                    <div class="container-fluid">
                        <div class="row">

                            <!--Main page-->
                        @RenderBody()
                            <!--End of main page-->

                    </div>
                    </div>
                </div>

                <!--Footer-->
            <partial name="_FooterPartial" />
                <!--End of footer-->
        </div>
        }
        else
        {
            <div class="content">
                <div class="container-fluid">
                    <div class="row">
                        @RenderBody()
                        <!--End of main page-->

                </div>
                </div>
            </div>
        }

    </div>
    
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/worker/registration.js"></script>
    <script src="~/assets/js/light-bootstrap-dashboard.js?v=1.4.0"></script>
    <script src="~/assets/js/bootstrap.min.js" type="text/javascript"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
