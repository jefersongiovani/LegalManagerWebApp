@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div style="width: 100%; max-width: 330px; padding: 15px; margin: auto; display: flex; align-items: center;">
    <div class="mb-4">
        <section class="text-center">
            <img src="~/assets/img/brand.png" alt="LegalManager brand" width="311" height="85" />
            <form id="account" method="post">

                <h3>Use a local account to log in.</h3>
                <hr />
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-floating mb-3">
                    <label asp-for="Input.Email">
                        Insert your E-mail
                    <input asp-for="Input.Email" autocomplete="username" class="form-control" id="floatingInput" placeholder="name@email.com" />
                    </label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <label asp-for="Input.Password">
                        Insert your password
                    <input asp-for="Input.Password" autocomplete="current-password" class="form-control" id="floatingPassword" />
                    </label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <div>
                        <label asp-for="Input.RememberMe">
                            <input  class="checkbox navbar-left" asp-for="Input.RememberMe" /> &emsp;
                            Remember me
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary btn-fill">Log in</button>
                </div>
                <div class="form-group">
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                    </p>
                    <p>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
        }
